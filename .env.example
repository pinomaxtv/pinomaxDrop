# RA_API_KEY: Required for RA API calls.
# RA Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the RA Studio UI.
RA_API_KEY="MY_RA_API_KEY"

# APP_URL: The URL where this applet is hosted.
# RA Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
